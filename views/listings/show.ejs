<% layout("layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
    </div>
    
    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://placehold.co/600x400/png?text=Default+Image'%>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">Owned by 
                <i><a href="/users/<%= listing.owner._id %>"><%= listing.owner.username %></a></i>
            </p>
            <p class="card-text">
                <%= listing.description %>
            </p>
            <p class="card-text">
                &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
            </p>
            <p class="card-text">
                <%= listing.location %>
            </p>
            <p class="card-text">
                <%= listing.country %>
            </p>
        </div>
    </div>
    <br>
</div>

<% if(currUser && listing.owner._id.equals(currUser._id)) { %>
<div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
    
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-5">Delete</button>
    </form>
</div>
<% } %>

<% if(currUser && !listing.owner._id.equals(currUser._id)) { %>
<div class="col-6 offset-3 mb-4">
    <div class="card card-body">
        <h4>Request to book</h4>
        <p class="text-muted mb-2">₹<%= listing.price.toLocaleString("en-IN") %> per night. Pending and confirmed dates are unavailable.</p>
        <form action="/listings/<%= listing._id %>/bookings" method="POST" class="row g-2" id="booking-form">
            <div class="col-md-4"><label class="form-label" for="checkIn">Check-in</label><input class="form-control" id="checkIn" type="date" name="booking[checkIn]" required></div>
            <div class="col-md-4"><label class="form-label" for="checkOut">Check-out</label><input class="form-control" id="checkOut" type="date" name="booking[checkOut]" required></div>
            <div class="col-md-2"><label class="form-label" for="guests">Guests</label><input class="form-control" id="guests" type="number" name="booking[guests]" min="1" max="20" value="1" required></div>
            <div class="col-md-2 d-flex align-items-end"><button class="btn btn-dark w-100">Request</button></div>
        </form>
        <% if(unavailableBookings.length) { %><small class="text-muted mt-2">Unavailable: <%= unavailableBookings.map((booking) => `${booking.checkIn.toLocaleDateString()}–${booking.checkOut.toLocaleDateString()}`).join(", ") %></small><% } %>
    </div>
</div>
<script>
    (() => {
        const form = document.getElementById("booking-form");
        const checkIn = document.getElementById("checkIn");
        const checkOut = document.getElementById("checkOut");
        const today = new Date().toISOString().split("T")[0];
        const ranges = <%- JSON.stringify(unavailableBookings.map((booking) => ({ start: booking.checkIn.toISOString().split("T")[0], end: booking.checkOut.toISOString().split("T")[0] }))) %>;
        checkIn.min = today;
        checkOut.min = today;
        checkIn.addEventListener("change", () => { checkOut.min = checkIn.value || today; });
        form.addEventListener("submit", (event) => {
            const start = checkIn.value;
            const end = checkOut.value;
            const overlaps = ranges.some((range) => start < range.end && end > range.start);
            if (!start || !end || end <= start || overlaps) {
                event.preventDefault();
                alert(overlaps ? "Those dates are unavailable." : "Choose a valid check-in and check-out date.");
            }
        });
    })();
</script>
<% } %>

<% if(currUser) { %>
<div class="col-6 offset-3 mb-4">
    <h4>Save this listing</h4>
    <% if(wishlists.length) { %>
        <div class="d-flex flex-wrap gap-2">
            <% wishlists.forEach((wishlist) => { %>
                <% if(!wishlist.listings.some((savedId) => savedId.equals(listing._id))) { %>
                    <form action="/wishlists/<%= wishlist._id %>/listings" method="POST">
                        <input type="hidden" name="listingId" value="<%= listing._id %>">
                        <button class="btn btn-outline-dark btn-sm"><i class="fa-regular fa-heart"></i> <%= wishlist.name %></button>
                    </form>
                <% } %>
            <% }) %>
        </div>
    <% } %>
    <form action="/wishlists" method="POST" class="row g-2 mt-1">
        <input type="hidden" name="listingId" value="<%= listing._id %>">
        <div class="col-md-5"><input class="form-control" name="name" maxlength="60" placeholder="New wishlist name" required></div>
        <div class="col-md-5"><input class="form-control" name="description" maxlength="200" placeholder="Optional description"></div>
        <div class="col-md-2"><button class="btn btn-dark w-100">Create</button></div>
    </form>
</div>
<% } %>

<div class="col-8 offset-3 mb-3">
    
    <% if(currUser) { %>
    <hr>
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
        
        <div class="mb-3 mt=3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>
        <div class="mb-3 mt=3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add some comments for review</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>

    </form>
    <hr>
    <% } %>
    

    <% if(listing.reviews.length > 0) { %>
    <div class="row">
        <p><b>All Reviews</b></p>
        <% for(review of listing.reviews) { %> 
                <div class="card col-5 ms-3 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@<%= review.author.username %></h5>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                        <p class="card-text"><%= review.comment %></p>
                        
                        <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    </div>
                </div>
        <% } %>
    </div>
    <% } %>
</div>
<div class="col-8 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div
            id="map"
            data-token="<%= mapToken %>"
            data-coords='<%- JSON.stringify(listing.geometry.coordinates) %>'
            data-title="<%= listing.title %>"
            data-location="<%= listing.location %>"
        ></div>

</div>

<script src="/js/map.js"></script>




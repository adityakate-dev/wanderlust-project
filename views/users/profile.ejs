<% layout("/layouts/boilerplate") %>
<div class="row mt-4"><div class="col-md-8 offset-md-2">
  <div class="card mb-4"><div class="card-body"><div class="d-flex align-items-center gap-3"><% if(profileUser.profileImage) { %><img src="<%= profileUser.profileImage %>" alt="<%= profileUser.username %>" class="rounded-circle" style="width:88px;height:88px;object-fit:cover"><% } else { %><div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center" style="width:88px;height:88px;font-size:2rem"><%= profileUser.username.charAt(0).toUpperCase() %></div><% } %><div><h2 class="mb-1"><%= profileUser.username %></h2><p class="mb-0 text-muted"><%= profileUser.bio || "Travel enthusiast" %></p></div></div></div></div>
  <% if(isOwner) { %><form action="/profile?_method=PUT" method="POST" class="card card-body mb-4"><h4>Edit profile</h4><div class="mb-3"><label class="form-label" for="bio">Bio</label><textarea class="form-control" id="bio" name="bio" maxlength="300" rows="3"><%= profileUser.bio %></textarea></div><div class="mb-3"><label class="form-label" for="profileImage">Profile image URL</label><input class="form-control" id="profileImage" type="url" name="profileImage" value="<%= profileUser.profileImage %>" placeholder="https://..."></div><button class="btn btn-dark align-self-start">Save profile</button></form><% } %>
  <h3><%= isOwner ? "My listings" : `${profileUser.username}'s listings` %></h3><% if(!listings.length) { %><p class="text-muted">No listings published yet.</p><% } %>
  <div class="row row-cols-1 row-cols-md-2 g-3"><% listings.forEach((listing) => { %><div class="col"><a class="listing-link" href="/listings/<%= listing._id %>"><div class="card h-100"><img src="<%= listing.image?.url || 'https://placehold.co/600x400/png?text=Listing' %>" class="card-img-top" alt="<%= listing.title %>" style="height:13rem;object-fit:cover"><div class="card-body"><h5><%= listing.title %></h5><p><%= listing.location %>, <%= listing.country %></p></div></div></a></div><% }) %></div>
</div></div>
